---
import Particles from './particles.astro';
import { getPreferredLocale, getTranslations } from "@/utils/i18n";

export interface Props {
    doc?: string;
    value?: string;
}

// Texts of the dialog asking before a link replaces values, see below
const i18n = getTranslations(getPreferredLocale(Astro.request.headers));
const replace = {
    title: i18n("replace-values-title"),
    description: i18n("replace-values-description"),
    cancel: i18n("replace-values-cancel"),
    action: i18n("replace-values-action")
};
---

<div id="document-wrapper" class="max-w-prose mx-auto" transition:name="render">
    <Particles data={{ ...Astro.props, replace }}></Particles>
    <article id="document-render" class="prose dark:prose-invert prose-img:rounded-md"></article>
</div>

<script>
    import { getParticles } from "@/utils/particles";
    import { markdownToHTML, updateOptional, updateComputed, updateNumbering, updateMargins, updateRender, repetitionInputs } from "@/utils/markdown";
    import { ContentEditable } from "@/components/custom/content-editable";
    import type { Props } from "./document-render.astro";
    import type { ConfirmDialogTexts } from "@/components/ui/confirm-dialog";

    document.addEventListener("astro:page-load", () => {
        const wrapper = document.getElementById("document-wrapper");
        const render = document.getElementById("document-render");
        if (!wrapper || !render) return;

        let { doc, value = String(), replace } = getParticles<Props & { replace: ConfirmDialogTexts }>(wrapper);

        let values: Record<string, string> = {
            ...(doc && JSON.parse(localStorage.getItem(doc) ?? "{}")),
            ...Object.fromEntries(new URLSearchParams(location.search))
        };

        // Values in the URL fragment, e.g. from a link returned by the API, are stored once and then
        // removed from the URL; anchors like #alignment contain no "=" and are thereby left alone
        if (location.hash.includes("=")) {
            const linked = Object.fromEntries(new URLSearchParams(location.hash.slice(1)));

            // As such a link is often opened again later on, values entered since are only replaced on request,
            // after the document is shown with them; the dialog is only loaded then, as it requires React
            const conflict = Object.keys(values).length > 0
                && Object.entries(linked).some(([key, value]) => values[key] !== value);
            if (!conflict) {
                values = { ...values, ...linked };
                if (doc) localStorage.setItem(doc, JSON.stringify(values));
            } else {
                import("@/components/ui/confirm-dialog")
                    .then(({ confirmDialog }) => confirmDialog(replace))
                    .then(confirmed => {
                        if (confirmed) updateRender.setValues?.({ ...values, ...linked });
                    });
            }

            history.replaceState(history.state, "", location.pathname + location.search);
        }

        // Intial render
        const renderDocument = () => {
            render!.innerHTML = markdownToHTML(value, values);

            updateOptional(render!, values);
            updateComputed(render!, values);
            updateNumbering(render!);
        }
        renderDocument();

        // Header and footer only exist while printing, so they are resolved right before it;
        // assigned rather than added, as this runs again on every page load
        window.onbeforeprint = () => updateMargins(value, values);

        // A link with new values only changes the fragment of an open document, which does not load it
        // anew, so it is reloaded to take them over just like on the first load
        window.onhashchange = () => {
            if (location.hash.includes("=")) location.reload();
        };

        // And renders based triggered by parents
        updateRender.setValue = input => {
            value = input;
            renderDocument();
        }

        updateRender.setValues = input => {
            values = input;
            renderDocument();
            if (doc) localStorage.setItem(doc, JSON.stringify(values));
        }

        render.addEventListener("input", ({ target }) => {
            if (target instanceof ContentEditable) {
                const { value, placeholder } = target;
                values[placeholder] = value;
                if (doc) localStorage.setItem(doc, JSON.stringify(values));

                // A repetition bound changes which rows exist, so the document is rendered anew,
                // continuing in the same occurrence of the field that is being typed in
                if (repetitionInputs.has(placeholder)) {
                    const selector = `content-editable[placeholder="${placeholder}"]`;
                    const index = [...render.querySelectorAll(selector)].indexOf(target);
                    renderDocument();
                    render.querySelectorAll<ContentEditable>(selector)[index]?.focusEnd();
                    return;
                }

                // Update inputs sharing the same placeholder (i.e., variable name)
                for (const element of render.querySelectorAll(`[placeholder="${placeholder}"]`)) {
                    if (element !== target) element.setAttribute("value", value);
                }

                updateComputed(render, values);
            }
        });

        render.addEventListener("change", ({ target }) => {
            if (target instanceof HTMLInputElement && target.classList.contains("optional-toggle")) {
                const key = `?${target.dataset.optional}`;
                // Unchecking a ??= toggle is stored explicitly, so its expression does not apply again
                if (target.checked) values[key] = "true";
                else if (target.dataset.expression) values[key] = "false";
                else delete values[key];
                if (doc) localStorage.setItem(doc, JSON.stringify(values));
                renderDocument();
            }
        });
    });
</script>

<style is:inline>
    .prose h1, .prose h2, .prose h3, .prose p, .prose p[class] img {
        margin-top: 0;
    }

    .prose p[class] img {
        display: inline-block;
    }

    .prose :not(pre) code {
        padding: 0.125em 0.25em;;
        border: 1px solid hsl(var(--border));
        border-radius: 0.25em;
        background-color: hsl(var(--secondary));
    }

    .prose code::before, .prose code::after {
        content: "";
    }

    .prose .optional-toggle {
        cursor: pointer;
        accent-color: hsl(var(--muted-foreground));
    }

    .prose .optional-toggle:disabled {
        cursor: default;
    }

    .prose [data-optional].excluded {
        opacity: 0.4;
    }

    /* Excluded entries drop out of the list numbering, matching the printed output */
    .prose ol > li[data-optional].excluded {
        counter-increment: list-item 0;
        list-style: none;
    }

    @media print {
        @page {
            margin: 2cm;

            font-size: 0.75rem;
            color: hsl(var(--border));

            @top-left {
                content: attr(top-left);
            }

            @top-center {
                content: attr(top-center);
            }

            @top-right {
                content: attr(top-right);
            }

            @bottom-left {
                content: attr(bottom-left);
            }

            @bottom-center {
                content: counter(page) " / " counter(pages);
            }

            @bottom-right {
                content: attr(bottom-right);
            }
        }

        .prose hr {
            visibility: hidden;
            margin: unset;
            break-after: page;
        }

        .prose :is(h1, h2, h3, h4) {
            break-after: avoid;
        }

        /* Tables move to the next page as a whole if possible; longer ones still break between rows only */
        .prose :is(table, tr) {
            break-inside: avoid;
        }

        .optional-toggle {
            display: none;
        }

        [data-optional].excluded {
            display: none;
        }

        /* Avoids a stray border when trailing table rows are excluded */
        .prose tbody tr:not(:has(~ tr:not(.excluded))) {
            border-bottom-width: 0;
        }
    }
</style>
